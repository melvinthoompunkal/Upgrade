# Encrypt as a systemd credential named backend.env. No browser build secrets.
DEPLOYMENT_MODE=hosted
DEPLOYMENT_ID=upgrade-production
DATA_ROOT=/var/lib/upgrade
APP_BASE_URL=https://upgrade.example.com
AUTH_MODE=github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
TOKEN_ENCRYPTION_KEYS=
MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
OPERATOR_GITHUB_IDS=[]
HOSTED_RELEASE_PATH=/etc/upgrade/releases/approved.json
# Target execution, private retrieval/analysis and PR publishing stay unavailable.
GITHUB_PRIVATE_FETCH_ENABLED=false
