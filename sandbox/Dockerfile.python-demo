FROM python:3.12-slim-bookworm@sha256:6dd8b6dab6b3adc7812bab69eca5dbdc1a5cc690ad28306d234ffb4ef8ac9753

COPY requirements.lock /opt/runner/requirements.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes \
      -r /opt/runner/requirements.lock
COPY pytest.ini test_isolation.py /opt/runner/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PYTHONPATH=/snapshot/src HOME=/tmp
USER 65532:65532
WORKDIR /snapshot
ENTRYPOINT ["python", "-m", "pytest"]
