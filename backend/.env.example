# Copy to backend/.env and enter the key locally. Never commit the .env file.
MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_TIMEOUT_SECONDS=45
META_MAX_RETRIES=2
META_MAX_COMPLETION_TOKENS=4096
META_TRACE_MAX_COMPLETION_TOKENS=8000

# Local mode preserves the existing single-machine sample workflows.
# GitHub mode is for local development; see docs/github-setup.md.
AUTH_MODE=local
APP_BASE_URL=http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Optional F2 private retrieval. Keep disabled until real-account validation.
GITHUB_PRIVATE_FETCH_ENABLED=false
GITHUB_APP_ID=
# Absolute path to the App RSA PEM key, outside source control/artifacts.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Comma-separated Fernet keys, newest first. Generate outside source control.
TOKEN_ENCRYPTION_KEYS=

# Local lifecycle policy. For hosted analysis use deploy/hosted/backend.env.example.
DEPLOYMENT_MODE=local
# Optional local storage override; hosted mode requires an absolute path.
DATA_ROOT=
DEPLOYMENT_ID=
HOSTED_RELEASE_PATH=
# Numeric GitHub IDs allowed to run paid Meta diagnostics in GitHub mode (JSON array).
OPERATOR_GITHUB_IDS=[]
JOB_LEASE_SECONDS=30
JOB_MAX_SECONDS=1200
JOB_OWNER_LIMIT=4
JOB_GLOBAL_LIMIT=16
JOB_ARTIFACT_BYTES=209715200
STORAGE_OWNER_BYTES=2147483648
STORAGE_GLOBAL_BYTES=8589934592
DAILY_GITHUB_REQUESTS=1000
DAILY_MODEL_ATTEMPTS=128
DAILY_MODEL_INPUT_TOKENS=1600000
DAILY_MODEL_OUTPUT_TOKENS=160000
GLOBAL_DAILY_GITHUB_REQUESTS=4000
GLOBAL_DAILY_MODEL_ATTEMPTS=512
GLOBAL_DAILY_MODEL_INPUT_TOKENS=6400000
GLOBAL_DAILY_MODEL_OUTPUT_TOKENS=640000
RETENTION_DAYS=30
